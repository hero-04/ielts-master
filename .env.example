# Copy to `.env` for local development. Production values live in Render's Environment tab.

# ── Django ───────────────────────────────────────────────────────────────
# Local dev: DEBUG=True lets you skip SECRET_KEY. Production: DEBUG=False and a real SECRET_KEY.
DEBUG=True
SECRET_KEY=
# Comma-separated. Render adds its own hostname automatically.
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ─────────────────────────────────────────────────────────────
# Leave empty to use local db.sqlite3. For Neon, paste the *pooled* connection string:
# postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ── Frontend / CORS ──────────────────────────────────────────────────────
# Comma-separated production frontend origins (localhost:3000 is always allowed).
FRONTEND_URL=https://ielts-master-red.vercel.app

# ── Feature switches ─────────────────────────────────────────────────────
# Public sign-up. False = private platform (admin creates accounts). True = anyone can register.
REGISTRATION_OPEN=False

# ── Media storage (optional) ─────────────────────────────────────────────
# If CLOUDINARY_CLOUD_NAME is set, uploads go to Cloudinary; otherwise to local ./media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
